# Copy to .env and fill at least the Groq key. With no keys the API runs in demo (mock) mode.
# Both have free tiers; no credit card needed.
GROQ_API_KEY=            # https://console.groq.com/keys   (primary: 2 models x 1,000 req/day)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys      (last-resort fallback, starts with sk-or-)

# Order the chain tries providers in (first healthy one wins)
PROVIDER_ORDER=groq,groq2,openrouter
# GROQ_MODEL=openai/gpt-oss-20b
# groq2 reuses GROQ_API_KEY with a second model (separate per-model quota)
# GROQ_MODEL_2=openai/gpt-oss-120b
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Shared L2 cache when running on Node (on Cloudflare Workers the KV binding in
# wrangler.toml is used instead). Upstash free tier: 500K commands/month.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=8787
CACHE_TTL_SEC=604800
RATE_DEVICE_PER_MIN=20
RATE_IP_PER_MIN=120
LLM_TIMEOUT_MS=8000
# MOCK_LLM=1             # force demo mode
# MOCK_LATENCY_MS=350
